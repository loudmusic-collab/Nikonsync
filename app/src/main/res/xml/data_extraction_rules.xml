<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing to back up: settings are tiny and the per-install GUID must stay unique to this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
